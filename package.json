{
  "name": "@oak-digital/payload-visual-editor",
  "version": "0.1.0",
  "description": "A Payload CMS plugin for inline editing and visual feedback.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "types": "./dist/exports/rsc.d.ts",
      "import": "./dist/exports/rsc.js",
      "default": "./dist/exports/rsc.js"
    },
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js",
      "default": "./dist/utilities.js"
    },
    "./preview": {
      "types": "./dist/hooks/use-shared-content-preview.d.ts",
      "import": "./dist/hooks/use-shared-content-preview.js",
      "default": "./dist/hooks/use-shared-content-preview.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "test": "pnpm test:unit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "dev": "node scripts/watch.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@swc/cli": "0.6.0",
    "@swc/core": "^1.15.0",
    "@types/node": "22.5.4",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "copyfiles": "2.4.1",
    "eslint": "^9.23.0",
    "jsdom": "^26.1.0",
    "payload": "3.79.0",
    "prettier": "^3.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rimraf": "3.0.2",
    "typescript": "5.7.3",
    "vitest": "4.0.18",
    "@payloadcms/richtext-lexical": "3.79.0",
    "@payloadcms/ui": "3.79.0",
    "next": "^16.3.8"
  },
  "peerDependencies": {
    "payload": "3.79.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@payloadcms/richtext-lexical": "3.79.0",
    "@payloadcms/ui": "3.79.0",
    "next": "^16.3.8"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/exports/client.d.ts",
        "import": "./dist/exports/client.js",
        "default": "./dist/exports/client.js"
      },
      "./rsc": {
        "types": "./dist/exports/rsc.d.ts",
        "import": "./dist/exports/rsc.js",
        "default": "./dist/exports/rsc.js"
      },
      "./utilities": {
        "types": "./dist/utilities.d.ts",
        "import": "./dist/utilities.js",
        "default": "./dist/utilities.js"
      },
      "./preview": {
        "types": "./dist/hooks/use-shared-content-preview.d.ts",
        "import": "./dist/hooks/use-shared-content-preview.js",
        "default": "./dist/hooks/use-shared-content-preview.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@swc/core"
    ]
  },
  "registry": "https://registry.npmjs.org/",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Oak-Digital/payloadcms-visual-editor.git"
  },
  "packageManager": "pnpm@10.30.0"
}
